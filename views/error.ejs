<%- include('partials/head', { pageTitle: pageTitle || 'Error' }) %>

<div style="min-height:50vh;display:flex;align-items:center;justify-content:center;padding:2rem">
  <div style="text-align:center;max-width:480px">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="width:56px;height:56px;margin:0 auto 1.5rem;color:#ef4444;opacity:.7"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
    <h1 style="font-size:1.5rem;margin-bottom:.5rem"><%= pageTitle || 'Error' %></h1>
    <p style="color:var(--text-muted);margin-bottom:1.5rem"><%= message || 'Something went wrong.' %></p>
    <a href="/" class="btn btn-primary">Return to Feed</a>
  </div>
</div>

<%- include('partials/footer') %>
