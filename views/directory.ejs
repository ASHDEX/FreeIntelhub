<%- include('partials/head', { pageTitle: 'Directory' }) %>

<div class="page-header">
  <h1>Directory</h1>
  <p>Browse coverage by vendor, source, or sector.</p>
</div>

<div class="filter-chips" style="margin-bottom:1.25rem">
  <a href="/directory?tab=vendors" class="filter-chip<%= tab === 'vendors' ? ' active' : '' %>">Vendors</a>
  <a href="/directory?tab=sources" class="filter-chip<%= tab === 'sources' ? ' active' : '' %>">Sources</a>
  <a href="/directory?tab=sectors" class="filter-chip<%= tab === 'sectors' ? ' active' : '' %>">Sectors</a>
</div>

<% if (entries.length === 0) { %>
  <p class="empty">No data yet. Articles are still being fetched.</p>
<% } else { %>
  <div class="vendor-grid">
    <% entries.forEach(function(e) { %>
      <a href="<%= e.href %>" class="vendor-card">
        <strong><%= e.name %></strong>
        <span><%= e.count %> article<%= e.count !== 1 ? 's' : '' %></span>
      </a>
    <% }); %>
  </div>
<% } %>

<%- include('partials/footer') %>
