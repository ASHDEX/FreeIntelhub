<%- include('partials/head', { pageTitle: 'Cases' }) %>

<%
  const totalCases    = cases.length;
  const openCount     = cases.filter(c => c.status === 'open').length;
  const inProgCount   = cases.filter(c => c.status === 'in-progress').length;
  const closedCount   = cases.filter(c => c.status === 'closed').length;
  const criticalCount = cases.filter(c => c.severity === 'critical').length;
%>

<link rel="stylesheet" href="/tailwind.css">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Manrope:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
<style>
  .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
  .glass-panel { background: rgba(35, 38, 44, 0.6); backdrop-filter: blur(20px); border: 1px solid rgba(246, 246, 252, 0.05); }
  .no-scrollbar::-webkit-scrollbar { display: none; }
  .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
  .neon-glow-primary { box-shadow: 0 0 15px rgba(129, 236, 255, 0.3); }
  .cases-container { background-color: var(--bg, #0c0e12); color: var(--text, #f6f6fc); font-family: 'Manrope', sans-serif; min-height: 100vh; padding: 2rem; }
</style>

<div class="cases-container">
  <div class="max-w-7xl mx-auto">
    <!-- Header Section -->
    <section class="mb-12 flex justify-between items-end">
      <div>
        <h2 class="text-4xl font-headline font-bold tracking-tight mb-2 text-on-surface">Investigation Cases</h2>
        <p class="text-on-surface-variant max-w-2xl text-sm">Group articles into investigations, track status, and add analyst notes.</p>
      </div>
      <button id="open-modal-btn" class="bg-primary text-[#003840] px-6 py-2 rounded-xl font-bold font-['Space_Grotesk'] hover:brightness-110 transition-all active:scale-95 neon-glow-primary">
          New Case
      </button>
    </section>

    <!-- Stats Section -->
    <div class="flex gap-4 overflow-x-auto no-scrollbar pb-8 mb-4">
      <div class="min-w-[150px] bg-surface-container-low p-6 rounded-xl">
        <p class="text-[11px] font-label font-bold uppercase tracking-widest text-on-surface-variant mb-2">Total</p>
        <h3 class="text-3xl font-headline font-bold text-on-surface"><%= totalCases %></h3>
      </div>
      <div class="min-w-[150px] bg-surface-container-low p-6 rounded-xl">
        <p class="text-[11px] font-label font-bold uppercase tracking-widest text-primary mb-2">Open</p>
        <h3 class="text-3xl font-headline font-bold text-primary"><%= openCount %></h3>
      </div>
      <div class="min-w-[150px] bg-surface-container-low p-6 rounded-xl">
        <p class="text-[11px] font-label font-bold uppercase tracking-widest text-tertiary mb-2">In Progress</p>
        <h3 class="text-3xl font-headline font-bold text-tertiary"><%= inProgCount %></h3>
      </div>
      <div class="min-w-[150px] bg-surface-container-low p-6 rounded-xl">
        <p class="text-[11px] font-label font-bold uppercase tracking-widest text-on-surface-variant mb-2">Closed</p>
        <h3 class="text-3xl font-headline font-bold text-on-surface-variant"><%= closedCount %></h3>
      </div>
      <div class="min-w-[150px] bg-surface-container-low p-6 rounded-xl border-l-2 border-outline-variant/10">
        <p class="text-[11px] font-label font-bold uppercase tracking-widest text-error mb-2">Critical</p>
        <h3 class="text-3xl font-headline font-bold text-error"><%= criticalCount %></h3>
      </div>
    </div>

    <!-- Sticky Filter Tabs -->
    <div class="sticky top-0 z-30 bg-[#0c0e12]/80 backdrop-blur-md py-4 mb-8">
      <div class="flex items-center gap-1 p-1 bg-surface-container-low rounded-xl w-fit">
        <% [['','All','all'],['open','Open','open'],['in-progress','In Progress','in-progress'],['closed','Closed','closed'],['false-positive','False Positive','false-positive']].forEach(function(tab) {
            var isActive = statusFilter === tab[0];
            var classes = isActive ? 'bg-surface-container-high text-primary' : 'text-on-surface-variant hover:text-on-surface transition-colors';
            var count = (typeof statusCounts !== 'undefined' && statusCounts) ? (statusCounts[tab[2]] || 0) : null;
        %>
          <a href="/cases<%= tab[0] ? '?status=' + tab[0] : '' %>" class="px-5 py-2 rounded-lg font-bold font-label text-xs <%= classes %>">
            <%= tab[1] %><% if (count !== null) { %> <span style="opacity:.7;font-weight:500">(<%= count %>)</span><% } %>
          </a>
        <% }); %>
      </div>
    </div>

    <!-- Grid of Case Cards -->
    <% if (cases.length === 0) { %>
      <div class="flex flex-col items-center justify-center p-12 bg-surface-container-low rounded-xl text-center">
        <span class="material-symbols-outlined text-4xl text-on-surface-variant mb-4">inbox</span>
        <p class="text-on-surface-variant">No cases found. Create one to start tracking an investigation.</p>
      </div>
    <% } else { %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% cases.forEach(function(c) { 
          var _sCol = c.severity === 'critical' ? 'bg-error' : c.severity === 'high' ? 'bg-secondary' : c.severity === 'medium' ? 'bg-tertiary' : 'bg-primary';
          var _sTx = c.severity === 'critical' ? 'text-error' : c.severity === 'high' ? 'text-secondary' : c.severity === 'medium' ? 'text-tertiary' : 'text-primary';
          
          var _stBg = c.status === 'open' ? 'bg-primary/10' : c.status === 'in-progress' ? 'bg-tertiary/10' : 'bg-on-surface-variant/10';
          var _stTx = c.status === 'open' ? 'text-primary' : c.status === 'in-progress' ? 'text-tertiary' : 'text-on-surface-variant';
        %>
          <a href="/cases/<%= c.id %>" class="bg-surface-container rounded-xl overflow-hidden relative group hover:bg-surface-container-high transition-all cursor-pointer block">
            <div class="absolute left-0 top-0 bottom-0 w-1 <%= _sCol %> opacity-80 group-hover:opacity-100"></div>
            <div class="p-6">
              <div class="flex justify-between items-start mb-4">
                <div class="flex gap-2">
                  <span class="px-2 py-1 rounded <%= _sTx %> <%= _sCol %>/10 text-[11px] font-bold font-label uppercase"><%= c.severity %></span>
                  <span class="px-2 py-1 rounded <%= _stBg %> <%= _stTx %> text-[11px] font-bold font-label uppercase"><%= c.status %></span>
                </div>
                <div class="flex items-center gap-1.5 text-on-surface-variant group-hover:text-on-surface transition-colors">
                  <span class="material-symbols-outlined text-sm">article</span>
                  <span class="text-[11px] font-bold font-label"><%= c.article_count %> <%= c.article_count === 1 ? 'Article' : 'Articles' %></span>
                </div>
              </div>
              <h4 class="text-lg font-headline font-bold text-on-surface mb-2 pt-2 group-hover:text-primary transition-colors pr-4"><%= c.title %></h4>
              <p class="text-on-surface-variant text-xs line-clamp-2 mb-6" title="<%= c.description || '' %>"><%= c.description || 'No description provided.' %></p>
              
              <div class="flex items-center justify-between pt-4 border-t border-outline-variant/10">
                <span class="text-[11px] text-on-surface-variant/70 font-label uppercase">Opened <%= new Date(c.created_at).toLocaleDateString('en-US',{month:'short',day:'numeric'}) %></span>
                <% if (c.updated_at !== c.created_at) { %>
                  <span class="text-[11px] text-on-surface-variant/70 font-label uppercase">Updated <%= new Date(c.updated_at).toLocaleDateString('en-US',{month:'short',day:'numeric'}) %></span>
                <% } else if (c.closed_at) { %>
                  <span class="text-[11px] text-on-surface-variant/70 font-label uppercase">Closed <%= new Date(c.closed_at).toLocaleDateString('en-US',{month:'short',day:'numeric'}) %></span>
                <% } %>
              </div>
            </div>
          </a>
        <% }); %>
      </div>
    <% } %>
  </div>
</div>

<!-- New Case Modal Overlay -->
<div class="fixed inset-0 z-50 items-center justify-center p-6 bg-background/60 backdrop-blur-sm hidden" id="new-case-modal">
  <div class="glass-panel max-w-lg w-full rounded-2xl p-8 shadow-2xl relative" style="border:1px solid rgba(246, 246, 252, 0.1)">
    <header class="mb-6">
      <h3 class="text-2xl font-headline font-bold text-on-surface tracking-tight">Create New Case</h3>
      <p class="text-on-surface-variant text-sm mt-1">Initiate a new investigation cluster from global telemetry.</p>
    </header>
    <form method="POST" action="/cases" class="space-y-5">
      <div>
        <label class="block text-[11px] font-label font-bold uppercase tracking-widest text-on-surface-variant mb-2">Case Title *</label>
        <input name="title" required class="w-full bg-surface-container-lowest border border-outline-variant/20 rounded-xl p-3 text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary/50 transition-all text-sm" placeholder="e.g. Unusual Traffic Pattern - Frankfurt" type="text"/>
      </div>
      <div>
        <label class="block text-[11px] font-label font-bold uppercase tracking-widest text-on-surface-variant mb-2">Severity</label>
        <select name="severity" class="w-full bg-surface-container-lowest border border-outline-variant/20 rounded-xl p-3 text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary/50 transition-all text-sm">
          <option value="low">Low</option>
          <option value="medium" selected>Medium</option>
          <option value="high">High</option>
          <option value="critical">Critical</option>
        </select>
      </div>
      <div>
        <label class="block text-[11px] font-label font-bold uppercase tracking-widest text-on-surface-variant mb-2">Description</label>
        <textarea name="description" class="w-full bg-surface-container-lowest border border-outline-variant/20 rounded-xl p-3 text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary/50 transition-all placeholder:text-outline/50 resize-y text-sm" placeholder="Detail the indicators of compromise..." rows="3"></textarea>
      </div>
      <div class="flex items-center justify-end gap-3 pt-3 border-t border-outline-variant/10 mt-2">
        <button id="cancel-modal-btn" class="px-5 py-2 rounded-xl text-sm font-bold font-label text-on-surface-variant hover:text-on-surface transition-colors" type="button">Cancel</button>
        <button class="bg-primary text-[#003840] px-6 py-2 rounded-xl text-sm font-bold font-label hover:brightness-110 transition-all active:scale-95 neon-glow-primary" type="submit">Create Case</button>
      </div>
    </form>
  </div>
</div>

<script nonce="<%= nonce %>">
  (function () {
    var modal   = document.getElementById('new-case-modal');
    var openBtn = document.getElementById('open-modal-btn');
    var cancelBtn = document.getElementById('cancel-modal-btn');
    function open()  { modal.classList.remove('hidden'); modal.classList.add('flex'); }
    function close() { modal.classList.remove('flex'); modal.classList.add('hidden'); }
    if (openBtn)   openBtn.addEventListener('click', open);
    if (cancelBtn) cancelBtn.addEventListener('click', close);
    modal.addEventListener('click', function(e) { if (e.target === modal) close(); });
    document.addEventListener('keydown', function(e) { if (e.key === 'Escape') close(); });
  })();
</script>

<%- include('partials/footer') %>
