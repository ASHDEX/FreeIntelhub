<%- include('partials/head', { pageTitle: 'Campaigns' }) %>

<div class="page-header">
  <h1>Campaigns</h1>
  <p>Named cyberattack campaigns and operations tracked across all feeds</p>
</div>

<% if (campaigns.length === 0) { %>
  <p class="empty">No campaigns indexed yet. Articles are being processed.</p>
<% } else { %>

  <%
    const active = campaigns.filter(c => c.recent_count > 0);
    const inactive = campaigns.filter(c => c.recent_count === 0);
  %>

  <% if (active.length > 0) { %>
    <section class="entity-section">
      <h2 class="entity-section-title">
        <span class="badge badge-red">Active</span>
        Active in Last 90 Days
      </h2>
      <div class="entity-grid">
        <% for (const c of active) { %>
          <a href="/campaign/<%= encodeURIComponent(c.name) %>" class="entity-card<%= c.is_auto_detected ? ' entity-card-auto' : '' %>">
            <div class="entity-card-header">
              <strong class="entity-name"><%= c.name %></strong>
            </div>
            <%
              let groups = [];
              try { groups = c.associated_groups ? JSON.parse(c.associated_groups) : []; } catch(_) {}
            %>
            <% if (groups.length > 0) { %>
              <p class="entity-desc">By: <%= groups.join(', ') %></p>
            <% } %>
            <% if (c.description) { %>
              <p class="entity-desc"><%= c.description.slice(0, 100) %><%= c.description.length > 100 ? '…' : '' %></p>
            <% } %>
            <div class="entity-stats">
              <span class="stat-pill stat-total"><%= c.total_count %> articles</span>
              <span class="stat-pill stat-recent"><%= c.recent_count %> in 90d</span>
              <% if (c.is_auto_detected) { %><span class="stat-pill stat-auto">auto-detected</span><% } %>
            </div>
          </a>
        <% } %>
      </div>
    </section>
  <% } %>

  <% if (inactive.length > 0) { %>
    <section class="entity-section">
      <h2 class="entity-section-title">Historical Campaigns</h2>
      <div class="entity-grid">
        <% for (const c of inactive) { %>
          <a href="/campaign/<%= encodeURIComponent(c.name) %>" class="entity-card entity-card-dim<%= c.is_auto_detected ? ' entity-card-auto' : '' %>">
            <div class="entity-card-header">
              <strong class="entity-name"><%= c.name %></strong>
              <% if (c.first_seen) { %><span class="entity-country"><%= c.first_seen.slice(0,7) %></span><% } %>
            </div>
            <%
              let groups = [];
              try { groups = c.associated_groups ? JSON.parse(c.associated_groups) : []; } catch(_) {}
            %>
            <% if (groups.length > 0) { %>
              <p class="entity-desc">By: <%= groups.join(', ') %></p>
            <% } %>
            <div class="entity-stats">
              <span class="stat-pill stat-total"><%= c.total_count %> articles</span>
              <% if (c.is_auto_detected) { %><span class="stat-pill stat-auto">auto-detected</span><% } %>
            </div>
          </a>
        <% } %>
      </div>
    </section>
  <% } %>
<% } %>

<%- include('partials/footer') %>
