<%- include('partials/head') %>

<%
  var critCount = highRiskArticles.filter(function(a){ return a.riskScore >= 75; }).length;
  var highCount = highRiskArticles.filter(function(a){ return a.riskScore >= 50 && a.riskScore < 75; }).length;
  var medCount  = highRiskArticles.filter(function(a){ return a.riskScore >= 25 && a.riskScore < 50; }).length;

  var _healthy  = feedHealth ? feedHealth.healthy || 0 : 0;
  var _total    = feedHealth ? feedHealth.total   || 0 : 0;
  var _hPct     = _total > 0 ? Math.round((_healthy / _total) * 100) : 100;

  var cveCount  = latestCves ? latestCves.length : 0;

  var avgRisk = highRiskArticles.length > 0
    ? Math.round(highRiskArticles.reduce(function(s,a){return s+a.riskScore;},0) / highRiskArticles.length)
    : 0;

  var actMax = 1;
  activity7d.forEach(function(d){ if(d.count > actMax) actMax = d.count; });

  var catMax = 1;
  categoryDist.forEach(function(c){ if(c.count > catMax) catMax = c.count; });
%>

<div class="page-title-bar">
  <div>
    <h1>Dashboard</h1>
    <p>A live snapshot of everything FreeIntelHub is tracking right now.</p>
  </div>
</div>

<div class="dash-stat-grid">
  <div class="stat-card">
    <span class="stat-card-label">Total Intel</span>
    <span class="stat-card-value"><%= totalCount.toLocaleString() %></span>
  </div>
  <div class="stat-card">
    <span class="stat-card-label">Last 24h</span>
    <span class="stat-card-value">+<%= articles24h.toLocaleString() %></span>
  </div>
  <div class="stat-card">
    <span class="stat-card-label">Avg Risk</span>
    <span class="stat-card-value" style="color:<%= avgRisk >= 75 ? 'var(--red)' : avgRisk >= 50 ? 'var(--amber)' : avgRisk >= 25 ? 'var(--purple)' : 'var(--accent)' %>"><%= avgRisk %></span>
  </div>
  <div class="stat-card">
    <span class="stat-card-label">CVEs in Feed</span>
    <span class="stat-card-value"><%= cveCount %></span>
  </div>
  <div class="stat-card">
    <span class="stat-card-label">Active Actors</span>
    <span class="stat-card-value"><%= threatGroups7d %></span>
  </div>
  <div class="stat-card">
    <span class="stat-card-label">Feed Health</span>
    <span class="stat-card-value" style="color:var(--accent)"><%= _hPct %>%</span>
  </div>
</div>

<div class="dash-chart-row">
  <div class="dash-panel">
    <h3 class="panel-title">Articles per day &mdash; last 7 days</h3>
    <div class="dash-bar-chart">
      <% activity7d.forEach(function(d) { %>
        <div class="dash-bar-col">
          <div class="dash-bar-fill" style="height: <%= Math.max(4, Math.round((d.count / actMax) * 120)) %>px" title="<%= d.count %> articles"></div>
          <span class="dash-bar-label"><%= d.label %></span>
        </div>
      <% }); %>
    </div>
  </div>
  <div class="dash-panel">
    <h3 class="panel-title">Intel by category</h3>
    <div class="dash-hbar-list">
      <% categoryDist.slice(0, 6).forEach(function(c) { %>
        <div class="dash-hbar-row">
          <span class="dash-hbar-label"><%= c.category %></span>
          <div class="dash-hbar-track"><div class="dash-hbar-fill" style="width: <%= Math.round((c.count / catMax) * 100) %>%"></div></div>
          <span class="dash-hbar-value"><%= c.count %></span>
        </div>
      <% }); %>
    </div>
  </div>
</div>

<div class="dash-chart-row">
  <div class="dash-panel dash-panel-donut">
    <h3 class="panel-title">Severity breakdown</h3>
    <div class="dash-donut-wrap">
      <canvas id="severity-chart" width="160" height="160"></canvas>
      <div class="dash-donut-center">
        <span class="dash-donut-value"><%= highRiskArticles.length %></span>
        <span class="dash-donut-label">Total</span>
      </div>
    </div>
  </div>
  <div class="dash-panel dash-panel-donut">
    <h3 class="panel-title">Intel by category</h3>
    <div class="dash-donut-wrap">
      <canvas id="category-chart" width="160" height="160"></canvas>
      <div class="dash-donut-center">
        <span class="dash-donut-value"><%= categoryDist.length %></span>
        <span class="dash-donut-label">Types</span>
      </div>
    </div>
  </div>
</div>

<div class="section-header">
  <h2>High-Risk Articles</h2>
  <a href="/iocs">View feed &rarr;</a>
</div>
<div class="dash-activity-list">
  <% if (highRiskArticles.length > 0) { %>
    <% highRiskArticles.slice(0, 6).forEach(function(a) {
      var _rs = a.riskScore >= 75 ? 'Critical' : a.riskScore >= 50 ? 'High' : 'Medium';
      var _dotColor = a.riskScore >= 75 ? 'var(--red)' : a.riskScore >= 50 ? 'var(--amber)' : 'var(--purple)';
      var _ageMs = a.published_at ? (Date.now() - new Date(a.published_at).getTime()) : Infinity;
      var _ageMins = Math.floor(_ageMs / 60000);
      var _rel = _ageMins < 60 ? _ageMins + 'm ago' : _ageMins < 1440 ? Math.floor(_ageMins/60) + 'h ago' : Math.floor(_ageMins/1440) + 'd ago';
    %>
      <a href="/article/<%= a.id %>" class="dash-activity-row">
        <span class="dash-activity-dot" style="background:<%= _dotColor %>"></span>
        <span class="dash-activity-text"><span class="dash-activity-sev" style="color:<%= _dotColor %>"><%= _rs %></span> &middot; <%= a.title %></span>
        <span class="dash-activity-time"><%= _rel %></span>
      </a>
    <% }); %>
  <% } else { %>
    <p class="empty">No high-risk articles detected.</p>
  <% } %>
</div>

<div class="section-header">
  <h2>Latest CVEs</h2>
</div>
<div class="dash-cve-grid">
  <% if (latestCves.length > 0) { %>
    <% latestCves.slice(0, 4).forEach(function(cve) {
      var _cveColor = cve.severity === 'CRITICAL' ? 'var(--red)' : cve.severity === 'HIGH' ? 'var(--amber)' : cve.severity === 'MEDIUM' ? 'var(--purple)' : 'var(--text-muted)';
    %>
      <a href="<%= safeHref(cve.link) %>" target="_blank" rel="noopener noreferrer" class="dash-cve-card" style="border-left-color:<%= _cveColor %>">
        <div class="dash-cve-top">
          <span class="dash-cve-id"><%= cve.id %></span>
          <span class="dash-cve-dot" style="background:<%= _cveColor %>"></span>
        </div>
        <p class="dash-cve-desc"><%= cve.description %></p>
      </a>
    <% }); %>
  <% } else { %>
    <p class="empty">CVE feed loading&hellip;</p>
  <% } %>
</div>

<div class="section-header">
  <h2>Recent Malware Samples</h2>
  <a href="https://malshare.com" target="_blank" rel="noopener noreferrer">View all &rarr;</a>
</div>
<p class="dash-malshare-ts">Last 24h &middot; <span id="malshare-ts">loading&hellip;</span></p>
<div id="malshare-list" class="dash-malshare-list">
  <p class="empty">Loading samples&hellip;</p>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js"></script>
<script nonce="<%= nonce %>">
(function(){
  var style = getComputedStyle(document.documentElement);
  var cCrit = style.getPropertyValue('--red').trim() || '#ef4444';
  var cHigh = style.getPropertyValue('--amber').trim() || '#fbbf24';
  var cMed  = style.getPropertyValue('--purple').trim() || '#a78bfa';
  var cLow  = style.getPropertyValue('--accent').trim() || '#22d3ee';
  var cBg   = style.getPropertyValue('--bg-card').trim() || '#111113';

  var sevCtx = document.getElementById('severity-chart');
  if (sevCtx) {
    new Chart(sevCtx, {
      type: 'doughnut',
      data: {
        labels: ['Critical','High','Medium','Low'],
        datasets: [{
          data: [<%= critCount %>, <%= highCount %>, <%= medCount %>, <%= Math.max(0, highRiskArticles.length - critCount - highCount - medCount) %>],
          backgroundColor: [cCrit, cHigh, cMed, cLow],
          borderWidth: 0, hoverOffset: 4,
          borderColor: cBg
        }]
      },
      options: { cutout: '80%', plugins: { legend: { display: false } } }
    });
  }

  var catCtx = document.getElementById('category-chart');
  if (catCtx) {
    var catColors = [cLow, '#818cf8', cMed, cHigh, cCrit, '#4ade80', '#f472b6', '#38bdf8'];
    var catData = <%- JSON.stringify(categoryDist.slice(0,8).map(function(c){ return c.count; })) %>;
    var catLabels = <%- JSON.stringify(categoryDist.slice(0,8).map(function(c){ return c.category; })) %>;
    new Chart(catCtx, {
      type: 'doughnut',
      data: {
        labels: catLabels,
        datasets: [{
          data: catData,
          backgroundColor: catColors.slice(0, catData.length),
          borderWidth: 0, hoverOffset: 4,
          borderColor: cBg
        }]
      },
      options: { cutout: '80%', plugins: { legend: { display: false } } }
    });
  }
})();
</script>

<script nonce="<%= nonce %>">
(function() {
  function esc(s) {
    if (s == null) return '';
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }
  var list = document.getElementById('malshare-list');
  var tsEl  = document.getElementById('malshare-ts');
  if (!list) return;
  fetch('/api/malshare/recent')
    .then(function(r) { return r.json(); })
    .then(function(json) {
      if (!json.samples || json.samples.length === 0) {
        list.innerHTML = '<p class="empty">MalShare feed unavailable &mdash; check MALSHARE_API_KEY.</p>';
        return;
      }
      if (tsEl) tsEl.textContent = new Date(json.ts).toLocaleTimeString() + ' · ' + json.count + ' samples';
      var html = '';
      json.samples.slice(0, 10).forEach(function(s, i) {
        var sha256Short = s.sha256 ? s.sha256.slice(0, 16) + '…' : 'N/A';
        var sourceDomain = '';
        if (s.source) {
          try { sourceDomain = new URL(s.source).hostname; } catch(_) { sourceDomain = s.source.slice(0, 40); }
        }
        var ageHours = Math.round((i / Math.max(json.count - 1, 1)) * 24);
        var ageLabel = ageHours === 0 ? '<1h ago' : ageHours + 'h ago';
        html += '<div class="dash-malshare-row">';
        if (s.type) {
          html += '<span class="badge badge-category">' + esc(s.type) + '</span>';
        }
        html += '<span class="dash-malshare-hash" title="' + esc(s.sha256 || '') + '">' + esc(sha256Short) + '</span>';
        if (sourceDomain) html += '<span class="dash-malshare-source">' + esc(sourceDomain) + '</span>';
        html += '<span class="dash-malshare-age">' + esc(ageLabel) + '</span>';
        html += '</div>';
      });
      list.innerHTML = html;
    })
    .catch(function() {
      list.innerHTML = '<p class="empty">Could not load MalShare feed.</p>';
    });
})();
</script>

<%- include('partials/footer') %>
