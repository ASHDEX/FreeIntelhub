<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>FreeIntelHub — Open Source Threat Intelligence</title>
  <meta name="description" content="Free cyber threat intelligence platform. Real-time feeds, IOC lookup, CVE prioritization, MITRE ATT&CK mapping.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="stylesheet" href="/landing.css">
</head>
<body>

<!-- BG -->
<div class="bg-layer" aria-hidden="true">
  <div class="bg-glow-center"></div>
  <div class="bg-orb-tl"></div>
  <div class="bg-orb-br"></div>
  <div class="bg-orb-mid"></div>
  <div class="bg-grid"></div>
  <div class="bg-vignette"></div>
</div>

<!-- NAV -->
<nav class="nav" id="nav" role="navigation" aria-label="Main navigation">
  <a href="/" class="nav-brand">
    <div class="nav-brand-logo" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M2.5 13c0-2 1.5-3.5 3.5-3.5h3c.5-3 1.5-6.5 2-6.5s1.5 3.5 2 6.5l4.5 1.5 3-2.5-1.5 4 1.5 3.5-3-1.5c-2 2-5.5 3.5-9 3.5l-2.5 1.5-1-2c-1.5-.5-2.5-1.5-2.5-3z"/></svg>
    </div>
    <span class="nav-brand-name">Free<em>Intel</em>Hub</span>
  </a>

  <div class="nav-center">
    <a href="/feed"          class="nav-link">Threat Feed</a>
    <a href="/threat-groups" class="nav-link">Actors</a>
    <a href="/cve-priority"  class="nav-link">CVEs</a>
    <a href="/mitre"         class="nav-link">MITRE</a>
    <a href="/lookup"        class="nav-link">IOC Lookup</a>
  </div>

  <div class="nav-right">
    <a href="/login"     class="btn-nav-ghost">Sign In</a>
    <a href="/dashboard" class="btn-nav-cta">Enter Platform</a>
  </div>
</nav>

<!-- HERO -->
<section class="hero" aria-labelledby="hero-h1">

  <div class="hero-badge">
    <span class="badge-pulse" aria-hidden="true"></span>
    Open Source &nbsp;·&nbsp; Free Forever &nbsp;·&nbsp; No Account Needed
  </div>

  <h1 class="hero-title" id="hero-h1">
    <span class="t1">Threat intelligence</span>
    <span class="t2">without the price tag.</span>
  </h1>

  <p class="hero-sub">
    Aggregates feeds from <b><%= sourceCount %>+ sources</b>, extracts IOCs, maps adversaries to
    MITRE ATT&amp;CK, and surfaces the CVEs that actually matter &mdash; no subscription required.
  </p>

  <div class="hero-actions">
    <a href="/dashboard" class="btn-enter">
      Enter Platform
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
    </a>
    <a href="/threat-groups" class="btn-secondary">
      Explore Threat Actors
    </a>
  </div>

  <!-- Stats -->
  <div class="stats-row" role="list" aria-label="Platform stats">
    <div class="stat" role="listitem">
      <span class="stat-n"><%= totalArticles.toLocaleString() %><span class="a">+</span></span>
      <span class="stat-l">Articles Indexed</span>
    </div>
    <div class="stat-sep" aria-hidden="true"></div>
    <div class="stat" role="listitem">
      <span class="stat-n"><%= threatGroupCount %><span class="a">+</span></span>
      <span class="stat-l">Threat Actors</span>
    </div>
    <div class="stat-sep" aria-hidden="true"></div>
    <div class="stat" role="listitem">
      <span class="stat-n"><%= sourceCount %><span class="a">+</span></span>
      <span class="stat-l">Intel Sources</span>
    </div>
    <div class="stat-sep" aria-hidden="true"></div>
    <div class="stat" role="listitem">
      <span class="stat-n">100<span class="a">%</span></span>
      <span class="stat-l">Free &amp; Open</span>
    </div>
  </div>

</section>

<!-- PRODUCT PREVIEW -->
<div class="preview-wrap" aria-hidden="true">
  <div class="preview-glow"></div>
  <div class="preview-panel" role="img" aria-label="Platform preview">
    <div class="preview-topbar">
      <span class="dot dot-r"></span>
      <span class="dot dot-y"></span>
      <span class="dot dot-g"></span>
      <span class="preview-topbar-title">FreeIntelHub — Dashboard</span>
    </div>
    <div class="preview-body">
      <!-- Sidebar -->
      <div class="preview-sidebar">
        <span class="ps-label">Core</span>
        <div class="ps-item active">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
          Dashboard
          <span class="ps-dot ps-dot-g"></span>
        </div>
        <div class="ps-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/></svg>
          Threat Feed
        </div>
        <div class="ps-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
          IOC Lookup
        </div>
        <span class="ps-label">Adversaries</span>
        <div class="ps-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
          Actors
        </div>
        <div class="ps-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="3 11 22 2 13 21 11 13 3 11"/></svg>
          MITRE ATT&amp;CK
        </div>
        <span class="ps-label">Intelligence</span>
        <div class="ps-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          CVE Priority
          <span class="ps-dot ps-dot-r"></span>
        </div>
      </div>
      <!-- Main -->
      <div class="preview-main">
        <div class="pm-header">
          <span class="pm-title">CVE Priority Feed</span>
          <span class="pm-badge">Live</span>
        </div>
        <div class="pm-cards">
          <div class="pm-card"><div class="pm-card-label">Critical</div><div class="pm-card-val r">12</div></div>
          <div class="pm-card"><div class="pm-card-label">EPSS &gt; 0.5</div><div class="pm-card-val c">7</div></div>
          <div class="pm-card"><div class="pm-card-label">CISA KEV</div><div class="pm-card-val">3</div></div>
        </div>
        <div class="pm-list">
          <div class="pm-row">
            <span class="pm-sev sev-c"></span>
            <span class="pm-cve-id">CVE-2026-1234</span>
            <span class="pm-cve-desc">Remote code execution in OpenSSH pre-auth</span>
            <span class="pm-cve-score sc">9.8</span>
          </div>
          <div class="pm-row">
            <span class="pm-sev sev-c"></span>
            <span class="pm-cve-id">CVE-2026-5678</span>
            <span class="pm-cve-desc">Privilege escalation — Windows Kernel</span>
            <span class="pm-cve-score sc">9.3</span>
          </div>
          <div class="pm-row">
            <span class="pm-sev sev-h"></span>
            <span class="pm-cve-id">CVE-2025-9012</span>
            <span class="pm-cve-desc">SSRF via crafted URL in Apache HTTP Server</span>
            <span class="pm-cve-score sh">8.1</span>
          </div>
          <div class="pm-row">
            <span class="pm-sev sev-h"></span>
            <span class="pm-cve-id">CVE-2025-3456</span>
            <span class="pm-cve-desc">Auth bypass in VMware vCenter Server</span>
            <span class="pm-cve-score sh">7.8</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- FEATURES -->
<section class="section" aria-labelledby="features-h2">
  <div class="sec-inner">
    <p class="sec-tag">Platform Capabilities</p>
    <h2 class="sec-h" id="features-h2">Everything an analyst needs</h2>
    <p class="sec-p">From raw feeds to structured intelligence. Aggregated, enriched, and ready to act on — completely free.</p>

    <div class="bento" role="list">

      <a href="/feed" class="bc bc-xl" role="listitem">
        <div class="bc-icon ic-cyan" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/></svg>
        </div>
        <span class="bc-chip chip-live">
          <span style="width:5px;height:5px;background:#4ade80;border-radius:50%;animation:pulse-dot 2s infinite"></span>
          Live
        </span>
        <h3 class="bc-title">Live Threat Feed</h3>
        <p class="bc-desc">
          Real-time aggregation from <strong style="color:rgba(255,255,255,.65)"><%= sourceCount %>+</strong> vetted sources. Auto-classified by sector, actor, and technique. Refreshed every 15 minutes with entity extraction and IOC detection.
        </p>
        <span class="bc-link" aria-hidden="true">
          Open Feed
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </span>
        <div class="card-blob" aria-hidden="true"></div>
      </a>

      <a href="/cve-priority" class="bc bc-md" role="listitem">
        <div class="bc-icon ic-red" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        </div>
        <h3 class="bc-title">CVE Priority</h3>
        <p class="bc-desc">Filter by EPSS, CISA KEV, PoC, exploit availability, and attack complexity. Newest CVEs always listed first.</p>
        <span class="bc-link" aria-hidden="true">
          View CVEs
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </span>
      </a>

      <a href="/lookup" class="bc bc-sm" role="listitem">
        <div class="bc-icon ic-indigo" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
        </div>
        <h3 class="bc-title">IOC Lookup</h3>
        <p class="bc-desc">Search IPs, domains, file hashes, and URLs across all ingested threat intel instantly.</p>
        <span class="bc-link" aria-hidden="true">
          Search
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </span>
      </a>

      <a href="/threat-groups" class="bc bc-lg" role="listitem">
        <div class="bc-icon ic-amber" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </div>
        <h3 class="bc-title">Threat Actors &amp; Campaigns</h3>
        <p class="bc-desc">Track <strong style="color:rgba(255,255,255,.65)"><%= threatGroupCount %>+</strong> APT groups with MITRE ATT&amp;CK TTPs, aliases, and country attribution — all linked to real-world articles.</p>
        <span class="bc-link" aria-hidden="true">
          View Actors
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </span>
      </a>

      <a href="/mitre" class="bc bc-sm" role="listitem">
        <div class="bc-icon ic-cyan" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="3 11 22 2 13 21 11 13 3 11"/></svg>
        </div>
        <h3 class="bc-title">MITRE ATT&amp;CK</h3>
        <p class="bc-desc">Full matrix with interactive technique heatmaps per actor.</p>
        <span class="bc-link" aria-hidden="true">
          Open Matrix
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </span>
      </a>

      <a href="/cases" class="bc bc-md" role="listitem">
        <div class="bc-icon ic-green" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
        </div>
        <span class="bc-chip chip-new">New</span>
        <h3 class="bc-title">Case Management</h3>
        <p class="bc-desc">Organize articles into investigations, track findings, and build structured incident reports.</p>
        <span class="bc-link" aria-hidden="true">
          Open Cases
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </span>
      </a>

    </div>
  </div>
</section>

<!-- HOW IT WORKS -->
<section class="how-section" aria-labelledby="how-h2">
  <div class="how-inner">
    <p class="sec-tag">How It Works</p>
    <h2 class="sec-h" id="how-h2">The intelligence pipeline</h2>
    <p class="sec-p" style="margin-bottom:3rem">Four automated stages turn raw web content into actionable threat intelligence.</p>

    <div class="how-grid" role="list">
      <div class="how-step" role="listitem">
        <span class="how-num">01</span>
        <p class="how-title">Ingest</p>
        <p class="how-desc">RSS, API, and scraper feeds from <%= sourceCount %>+ trusted cybersecurity sources pulled every 15 minutes and deduplicated.</p>
      </div>
      <div class="how-step" role="listitem">
        <span class="how-num">02</span>
        <p class="how-title">Extract</p>
        <p class="how-desc">NLP entity extraction identifies IOCs, threat actors, software, and CVEs from every article automatically.</p>
      </div>
      <div class="how-step" role="listitem">
        <span class="how-num">03</span>
        <p class="how-title">Enrich</p>
        <p class="how-desc">Cross-referenced against MITRE ATT&amp;CK, Malpedia, NVD, EPSS, and CISA KEV for structured intelligence.</p>
      </div>
      <div class="how-step" role="listitem">
        <span class="how-num">04</span>
        <p class="how-title">Prioritize</p>
        <p class="how-desc">Risk scoring surfaces threats and vulnerabilities that need your attention now — not raw noise.</p>
      </div>
    </div>
  </div>
</section>

<!-- FINAL CTA -->
<section class="cta-section" aria-labelledby="cta-h2">
  <div class="cta-box">
    <div class="cta-glow" aria-hidden="true"></div>
    <h2 id="cta-h2">Start tracking threats today.</h2>
    <p>No account required. No credit card. No gatekeeping.<br>Just threat intelligence that works.</p>
    <div class="cta-btns">
      <a href="/dashboard" class="btn-enter" style="font-size:.95rem;padding:.9rem 2.2rem">
        Enter Platform
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true" width="17" height="17"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
      <a href="/feed" class="btn-secondary" style="font-size:.9rem">
        Browse Threat Feed
      </a>
    </div>
  </div>
</section>

<!-- FOOTER -->
<footer class="footer" role="contentinfo">
  <div class="footer-brand">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" width="14" height="14" style="color:#22d3ee"><polygon points="3 11 22 2 13 21 11 13 3 11"/></svg>
    <strong>FreeIntelHub</strong> &mdash; Open source CTI platform. Free forever.
  </div>
  <nav class="footer-links" aria-label="Footer links">
    <a href="/feed">Threat Feed</a>
    <a href="/dashboard">Dashboard</a>
    <a href="/threat-groups">Actors</a>
    <a href="/cve-priority">CVEs</a>
    <a href="/vulnerability">CVE Lookup</a>
    <a href="/mitre">MITRE</a>
    <a href="/login">Sign In</a>
  </nav>
</footer>

<script nonce="<%= nonce %>">
  // Nav scroll tint
  (function () {
    var nav = document.getElementById('nav');
    if (!nav) return;
    var onScroll = function () {
      if (window.scrollY > 40) nav.classList.add('scrolled');
      else nav.classList.remove('scrolled');
    };
    window.addEventListener('scroll', onScroll, { passive: true });
  })();

  // Restore saved theme token (if user had toggled theme in main app)
  (function () {
    var t = localStorage.getItem('theme');
    if (t === 'light') document.documentElement.setAttribute('data-theme', 'light');
  })();
</script>

</body>
</html>
