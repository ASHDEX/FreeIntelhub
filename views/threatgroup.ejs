<%- include('partials/head', { pageTitle: group.name }) %>

<%
  const typeColor = { 'nation-state':'badge-red','cybercriminal':'badge-orange','hacktivist':'badge-blue','unknown':'badge-gray' };
  const typeLabel = { 'nation-state':'Nation-State','cybercriminal':'Cybercriminal','hacktivist':'Hacktivist','unknown':'Unknown' };
  const motivationColor = { 'espionage':'badge-red','financial':'badge-orange','disruption':'badge-yellow','ip-theft':'badge-purple','unknown':'badge-gray' };
  const motivationLabel = { 'espionage':'Espionage','financial':'Financial','disruption':'Disruption','ip-theft':'IP Theft','unknown':'Unknown Motive' };
  const confidenceColor = { 'high':'#22c55e','medium':'#f59e0b','low':'#94a3b8' };
  const confidenceLabel = { 'high':'High Confidence','medium':'Medium Confidence','low':'Low Confidence' };
  const tacticLabel = {
    'reconnaissance':'Recon','resource-development':'Resource Dev','initial-access':'Initial Access',
    'execution':'Execution','persistence':'Persistence','privilege-escalation':'Priv Esc',
    'defense-evasion':'Defense Evasion','credential-access':'Cred Access','discovery':'Discovery',
    'lateral-movement':'Lateral Mov','collection':'Collection','command-and-control':'C2',
    'exfiltration':'Exfiltration','impact':'Impact','unknown':'Other'
  };
%>

<nav class="breadcrumb" aria-label="Breadcrumb">
  <a href="/" class="breadcrumb-item">Home</a>
  <span class="breadcrumb-sep" aria-hidden="true">›</span>
  <a href="/threat-groups" class="breadcrumb-item">Actors</a>
  <span class="breadcrumb-sep" aria-hidden="true">›</span>
  <span class="breadcrumb-item breadcrumb-current" aria-current="page"><%= group.name %></span>
</nav>

<div class="page-header">
  <div class="entity-header">
    <div class="entity-header-title">
      <h1><%= group.name %></h1>
      <div class="entity-badges">
        <span class="badge <%= typeColor[group.type] || 'badge-gray' %>"><%= typeLabel[group.type] || group.type %></span>
        <% if (group.country) { %><span class="badge badge-neutral"><%= group.country %></span><% } %>
        <% if (group.motivation && group.motivation !== 'unknown') { %>
          <span class="badge <%= motivationColor[group.motivation] || 'badge-gray' %>"><%= motivationLabel[group.motivation] || group.motivation %></span>
        <% } %>
        <% if (group.attribution_confidence) { %>
          <span class="badge" style="background:transparent;color:<%= confidenceColor[group.attribution_confidence] || '#94a3b8' %>;border:1px solid <%= confidenceColor[group.attribution_confidence] || '#94a3b8' %>55" title="Attribution confidence is probabilistic — not binary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="10" height="10" style="display:inline; margin-right:2px"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            <%= confidenceLabel[group.attribution_confidence] %>
          </span>
        <% } %>
        <% if (group.mitre_group_id) { %>
          <a href="https://attack.mitre.org/groups/<%= group.mitre_group_id %>/" target="_blank" rel="noopener noreferrer" class="badge badge-mitre" style="text-decoration:none">MITRE <%= group.mitre_group_id %> ↗</a>
        <% } %>
        <% if (group.is_auto_detected) { %><span class="badge badge-gray">auto-detected</span><% } %>
      </div>
    </div>
    <% if (group.description) { %>
      <p class="entity-description"><%= group.description %></p>
    <% } %>
    <% if (group.aliases && group.aliases.length > 0) { %>
      <p class="entity-aliases"><strong>Also known as:</strong> <%= group.aliases.join(', ') %></p>
    <% } %>
    <% if (group.targetingSectors && group.targetingSectors.length > 0) { %>
      <p class="entity-aliases" style="margin-top:.5rem;display:flex;align-items:center;gap:.4rem;flex-wrap:wrap">
        <strong style="font-size:.8rem;color:var(--text-muted);white-space:nowrap">Targets:</strong>
        <% group.targetingSectors.forEach(function(s) { %><span class="badge badge-neutral" style="font-size:.7rem"><%= s %></span><% }); %>
      </p>
    <% } %>
    <% if (group.targetingGeographies && group.targetingGeographies.length > 0) { %>
      <p class="entity-aliases" style="margin-top:.3rem;display:flex;align-items:center;gap:.4rem;flex-wrap:wrap">
        <strong style="font-size:.8rem;color:var(--text-muted);white-space:nowrap">Regions:</strong>
        <% group.targetingGeographies.forEach(function(g) { %><span class="badge" style="font-size:.7rem;background:rgba(59,130,246,.1);color:#60a5fa;border:1px solid rgba(59,130,246,.2)"><%= g %></span><% }); %>
      </p>
    <% } %>
    <% if (group.malpedia_slug) { %>
      <p class="entity-aliases" style="margin-top:.4rem;display:flex;align-items:center;gap:.5rem;flex-wrap:wrap;">
        <a href="https://malpedia.caad.fkie.fraunhofer.de/details/<%= encodeURIComponent(group.malpedia_slug) %>" target="_blank" rel="noopener noreferrer" class="badge" style="background:rgba(99,102,241,.15);color:#818cf8;border:1px solid rgba(99,102,241,.3);text-decoration:none;font-size:.72rem;">Malpedia ↗</a>
        <% try { var _refs = JSON.parse(group.malpedia_refs || '[]'); if (_refs.length) { %><span class="badge" style="font-size:.7rem;color:var(--text-muted);border:1px solid var(--border)"><%= _refs.length %> research refs</span><% } } catch(_e){} %>
      </p>
    <% } %>
  </div>
</div>

<!-- Watch This / Edit Profile buttons -->
<div style="margin:-1rem 0 1.25rem;display:flex;gap:.5rem;flex-wrap:wrap">
  <button id="watch-btn" class="btn btn-sm" onclick="watchActor('<%= group.name.replace(/'/g, "\\'") %>')">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="13" height="13" style="display:inline; margin-right:.3rem"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
    Watch this Actor
  </button>
  <button class="hidden btn btn-sm" id="edit-profile-btn" onclick="toggleProfileEditor()">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="13" height="13" style="display:inline; margin-right:.3rem"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
    Edit Profile
  </button>
</div>

<!-- AI Intelligence Brief -->
<section class="activity-section">
  <h2 style="display:flex;align-items:center;gap:.5rem">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="15" height="15" style="color:var(--accent)"><path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2z"/><path d="M12 8v4l3 3"/></svg>
    AI Intelligence Brief
    <span class="hidden" id="ai-brief-badge" style="font-size:.65rem;font-weight:600;padding:.1rem .4rem;border-radius:4px;background:var(--bg-elevated);color:var(--text-muted);border:1px solid var(--border)">cached</span>
  </h2>
  <div id="ai-brief-card" class="ai-brief-card">
    <div class="ai-brief-prompt"><button class="ai-brief-gen-btn" id="ai-brief-btn"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14" style="flex-shrink:0"><path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2z"/><path d="M12 8v4l3 3"/></svg> Additional Insights</button></div>
  </div>
</section>

<!-- Observed ATT&CK TTPs (aggregated from intel articles) -->
<% if (typeof observedTtps !== 'undefined' && observedTtps.length > 0) { %>
<section class="activity-section">
  <h2 style="display:flex;align-items:center;gap:.5rem;flex-wrap:wrap">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="15" height="15" style="color:#f59e0b"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
    Observed ATT&CK TTPs
    <span style="font-size:.65rem;font-weight:600;padding:.15rem .45rem;border-radius:4px;background:rgba(245,158,11,.1);color:#f59e0b;border:1px solid rgba(245,158,11,.25)">from intel feed</span>
    <a href="https://attack.mitre.org/groups/<%= group.mitre_group_id || '' %>/" target="_blank" rel="noopener noreferrer" style="margin-left:auto;font-size:.75rem;color:var(--text-muted);text-decoration:none"><% if (group.mitre_group_id) { %>Full ATT&CK profile ↗<% } %></a>
  </h2>
  <div style="overflow-x:auto">
    <table style="width:100%;border-collapse:collapse;font-size:.8rem">
      <thead>
        <tr style="border-bottom:1px solid var(--border)">
          <th style="text-align:left;padding:.4rem .6rem;color:var(--text-muted);font-weight:600;white-space:nowrap">Tactic</th>
          <th style="text-align:left;padding:.4rem .6rem;color:var(--text-muted);font-weight:600">Techniques Observed</th>
        </tr>
      </thead>
      <tbody>
        <% observedTtps.forEach(function(row) { %>
        <tr style="border-bottom:1px solid var(--border-subtle,rgba(148,163,184,.1))">
          <td style="padding:.5rem .6rem;white-space:nowrap;vertical-align:top">
            <span style="display:inline-block;padding:.15rem .45rem;border-radius:4px;background:rgba(245,158,11,.1);color:#f59e0b;font-size:.7rem;font-weight:600;text-transform:uppercase;letter-spacing:.03em">
              <%= tacticLabel[row.tactic] || row.tactic %>
            </span>
          </td>
          <td style="padding:.5rem .6rem">
            <div style="display:flex;flex-wrap:wrap;gap:.3rem">
              <% row.techniques.forEach(function(t) { %>
                <span style="display:inline-flex;align-items:center;gap:.25rem;padding:.15rem .4rem;border-radius:4px;background:var(--bg-elevated);border:1px solid var(--border);font-size:.72rem" title="<%= t.name %> — seen in <%= t.count %> article<%= t.count !== 1 ? 's' : '' %>">
                  <code style="color:var(--accent);font-size:.68rem"><%= t.id %></code>
                  <span style="color:var(--text-secondary)"><%= t.name.length > 28 ? t.name.slice(0,28)+'…' : t.name %></span>
                  <span style="color:var(--text-muted);font-size:.65rem">×<%= t.count %></span>
                </span>
              <% }); %>
            </div>
          </td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
  <p style="font-size:.72rem;color:var(--text-muted);margin-top:.6rem">
    Techniques inferred from article text in your intel feed. ×N = article occurrences. TTPs are more durable signals than IOCs.
  </p>
</section>
<% } %>

<!-- Analyst Profile Editor (analysts only — hidden by default) -->
<section class="hidden activity-section" id="profile-editor-section">
  <h2 style="display:flex;align-items:center;gap:.5rem">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="15" height="15" style="color:var(--text-muted)"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
    Edit Profile
  </h2>
  <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:.75rem;background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:1rem">
    <label style="display:flex;flex-direction:column;gap:.3rem;font-size:.8rem;color:var(--text-muted)">
      Motivation
      <select id="pe-motivation" style="background:var(--bg-elevated);border:1px solid var(--border);border-radius:4px;padding:.35rem .5rem;color:var(--text-primary);font-size:.8rem">
        <option value="">— unchanged —</option>
        <option value="espionage" <%= group.motivation==='espionage'?'selected':'' %>>Espionage</option>
        <option value="financial" <%= group.motivation==='financial'?'selected':'' %>>Financial</option>
        <option value="disruption" <%= group.motivation==='disruption'?'selected':'' %>>Disruption</option>
        <option value="ip-theft" <%= group.motivation==='ip-theft'?'selected':'' %>>IP Theft</option>
        <option value="unknown" <%= group.motivation==='unknown'?'selected':'' %>>Unknown</option>
      </select>
    </label>
    <label style="display:flex;flex-direction:column;gap:.3rem;font-size:.8rem;color:var(--text-muted)">
      Attribution Confidence
      <select id="pe-confidence" style="background:var(--bg-elevated);border:1px solid var(--border);border-radius:4px;padding:.35rem .5rem;color:var(--text-primary);font-size:.8rem">
        <option value="">— unchanged —</option>
        <option value="low" <%= group.attribution_confidence==='low'?'selected':'' %>>Low</option>
        <option value="medium" <%= group.attribution_confidence==='medium'?'selected':'' %>>Medium</option>
        <option value="high" <%= group.attribution_confidence==='high'?'selected':'' %>>High</option>
      </select>
    </label>
    <label style="display:flex;flex-direction:column;gap:.3rem;font-size:.8rem;color:var(--text-muted)">
      Target Sectors (comma-separated)
      <input id="pe-sectors" type="text" value="<%= (group.targetingSectors || []).join(', ') %>" placeholder="Finance, Healthcare…" style="background:var(--bg-elevated);border:1px solid var(--border);border-radius:4px;padding:.35rem .5rem;color:var(--text-primary);font-size:.8rem">
    </label>
    <label style="display:flex;flex-direction:column;gap:.3rem;font-size:.8rem;color:var(--text-muted)">
      Target Regions (comma-separated)
      <input id="pe-geos" type="text" value="<%= (group.targetingGeographies || []).join(', ') %>" placeholder="US, EU, Asia-Pacific…" style="background:var(--bg-elevated);border:1px solid var(--border);border-radius:4px;padding:.35rem .5rem;color:var(--text-primary);font-size:.8rem">
    </label>
  </div>
  <div style="margin-top:.6rem;display:flex;gap:.5rem;align-items:center">
    <button class="btn btn-sm btn-accent" onclick="saveProfile()">Save Profile</button>
    <span id="pe-status" style="font-size:.78rem;color:var(--text-muted)"></span>
  </div>
</section>

<!-- Relationship Graph -->
<section class="activity-section">
  <h2>Entity Relationships</h2>
  <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:1rem;overflow:hidden">
    <canvas id="rel-graph" style="width:100%;height:320px;display:block"></canvas>
    <p style="font-size:.75rem;color:var(--text-muted);text-align:center;margin-top:.5rem">Co-occurrence relationships based on article mentions. Node size = frequency.</p>
  </div>
</section>

<!-- Related YARA Rules -->
<section class="hidden activity-section" id="yara-section">
  <h2 style="display:flex;align-items:center;gap:.5rem;flex-wrap:wrap">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="15" height="15" style="color:#22c55e"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
    Related YARA Rules
    <span id="yara-count-badge" style="font-size:.65rem;font-weight:600;padding:.15rem .45rem;border-radius:4px;background:rgba(34,197,94,.1);color:#22c55e;border:1px solid rgba(34,197,94,.25)"></span>
    <a id="yara-view-all" href="/yara-rules" style="margin-left:auto;font-size:.75rem;color:var(--text-muted);text-decoration:none">View all on YARA Rules page →</a>
  </h2>
  <div id="yara-results-wrap"></div>
</section>

<!-- 90-Day Activity Chart -->
<section class="activity-section">
  <h2>90-Day Activity</h2>
  <div class="chart-container chart-container-sm">
    <canvas id="activity-chart"></canvas>
  </div>
</section>

<!-- Articles -->
<section>
  <div class="entity-articles-header">
    <h2>
      <%= showAll ? 'All Articles' : 'Last 90 Days' %>
      <span class="entity-count">(<%= total %>)</span>
    </h2>
    <div class="entity-toggle">
      <% if (showAll) { %>
        <a href="<%= baseUrl %>" class="btn btn-sm">Last 90 Days</a>
        <span class="btn btn-sm btn-accent">All Time</span>
      <% } else { %>
        <span class="btn btn-sm btn-accent">Last 90 Days</span>
        <a href="<%= baseUrl %>?all=1" class="btn btn-sm">All Time</a>
      <% } %>
    </div>
  </div>

  <% if (articles.length === 0) { %>
    <p class="empty">No articles found for this period.</p>
  <% } else { %>
    <%- include('partials/articleList', { articles }) %>
    <%- include('partials/pagination', { page, pages, baseUrl: showAll ? baseUrl + '?all=1' : baseUrl }) %>
  <% } %>
</section>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js"></script>
<script nonce="<%= nonce %>">
(function() {
  var aiBriefBtn = document.getElementById('ai-brief-btn');
  if (aiBriefBtn) aiBriefBtn.addEventListener('click', function() { fetchAiBrief('threat-group', <%= group.id %>); });
})();
</script>
<script nonce="<%= nonce %>">
(function() {
  var days  = <%- JSON.stringify(dailyCounts.map(d => d.day.slice(5))) %>;
  var counts = <%- JSON.stringify(dailyCounts.map(d => d.count)) %>;
  var ctx = document.getElementById('activity-chart').getContext('2d');
  new Chart(ctx, {
    type: 'bar',
    data: {
      labels: days,
      datasets: [{
        label: 'Articles',
        data: counts,
        backgroundColor: 'rgba(239,68,68,0.6)',
        borderColor: '#ef4444',
        borderWidth: 1,
        borderRadius: 2,
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: { legend: { display: false } },
      scales: {
        x: { ticks: { maxTicksLimit: 10, color: '#94a3b8' }, grid: { color: 'rgba(148,163,184,0.1)' } },
        y: { beginAtZero: true, ticks: { color: '#94a3b8', stepSize: 1 }, grid: { color: 'rgba(148,163,184,0.1)' } }
      }
    }
  });
})();
</script>

<script nonce="<%= nonce %>">
// Relationship graph (vanilla canvas force simulation)
(function() {
  var canvas = document.getElementById('rel-graph');
  if (!canvas) return;
  var ctx = canvas.getContext('2d');
  var W = canvas.offsetWidth; var H = 320;
  canvas.width = W; canvas.height = H;

  var nodes = [
    { id: 0, label: '<%= group.name %>', type: 'actor', x: W/2, y: H/2, r: 18, color: '#ef4444', count: <%= total %> }
  ];

  <% if (typeof relatedMalware !== 'undefined') { relatedMalware.slice(0,6).forEach(function(m, i) { %>
    nodes.push({ id: <%= i+1 %>, label: '<%= m.name.replace(/'/g, "\\'") %>', type: 'malware', x: W/2 + 120*Math.cos(2*Math.PI*<%= i %>/6), y: H/2 + 100*Math.sin(2*Math.PI*<%= i %>/6), r: 12, color: '#fbbf24', count: <%= m.count || 1 %> });
  <% }); } %>

  var edges = nodes.slice(1).map(function(n) { return { from: 0, to: n.id }; });

  function draw() {
    ctx.clearRect(0,0,W,H);
    var isDark = document.documentElement.getAttribute('data-theme') !== 'light';
    // Draw edges
    ctx.strokeStyle = isDark ? 'rgba(148,163,184,.25)' : 'rgba(71,85,105,.2)';
    ctx.lineWidth = 1.5;
    edges.forEach(function(e) {
      var a = nodes[e.from]; var b = nodes[e.to];
      ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y); ctx.stroke();
    });
    // Draw nodes
    nodes.forEach(function(n) {
      ctx.beginPath(); ctx.arc(n.x, n.y, n.r, 0, 2*Math.PI);
      ctx.fillStyle = n.color + '33'; ctx.fill();
      ctx.strokeStyle = n.color; ctx.lineWidth = 2; ctx.stroke();
      ctx.fillStyle = isDark ? '#f1f5f9' : '#1e293b';
      ctx.font = 'bold 11px system-ui,sans-serif'; ctx.textAlign = 'center';
      ctx.fillText(n.label.length > 12 ? n.label.slice(0,12)+'…' : n.label, n.x, n.y + n.r + 13);
    });
  }
  draw();
  document.getElementById('theme-toggle') && document.getElementById('theme-toggle').addEventListener('click', function() { setTimeout(draw, 50); });
})();

// Watch actor
function watchActor(name) {
  var token = localStorage.getItem('fih_subscriber_token') || prompt('Enter your subscriber token:');
  if (!token) return;
  localStorage.setItem('fih_subscriber_token', token);
  fetch('/api/watchlist', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ token: token, watch_type: 'actor', watch_value: name }) })
    .then(function(r) { return r.json(); })
    .then(function(d) {
      var btn = document.getElementById('watch-btn');
      if (d.ok) { btn.textContent = 'Watching!'; btn.style.color = '#22c55e'; }
      else { btn.textContent = d.error || 'Failed'; }
    });
}

// Profile editor (analyst-only — show Edit Profile button if session indicates analyst/admin)
(function() {
  // Check if current session is analyst/admin by probing a lightweight sentinel endpoint
  fetch('/api/threat-groups', { method: 'HEAD' }).then(function(r) {
    // If logged in (session exists), show the edit button
    // We check session-gated endpoint; 200 = accessible regardless of auth level.
    // The actual save is auth-gated server-side. Show button always so analysts can try.
    var btn = document.getElementById('edit-profile-btn');
    if (btn) btn.style.display = '';
  }).catch(function() {});
})();

function toggleProfileEditor() {
  var sec = document.getElementById('profile-editor-section');
  if (sec) sec.style.display = sec.style.display === 'none' ? '' : 'none';
}

function saveProfile() {
  var motivation = document.getElementById('pe-motivation').value;
  var confidence = document.getElementById('pe-confidence').value;
  var sectors = document.getElementById('pe-sectors').value.split(',').map(function(s){ return s.trim(); }).filter(Boolean);
  var geos = document.getElementById('pe-geos').value.split(',').map(function(s){ return s.trim(); }).filter(Boolean);
  var payload = {};
  if (motivation) payload.motivation = motivation;
  if (confidence) payload.attribution_confidence = confidence;
  payload.targeting_sectors = sectors;
  payload.targeting_geographies = geos;
  var statusEl = document.getElementById('pe-status');
  statusEl.textContent = 'Saving…';
  fetch('/api/threat-group/<%= group.id %>/profile', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify(payload) })
    .then(function(r) { return r.json(); })
    .then(function(d) {
      if (d.ok) { statusEl.textContent = 'Saved — reload to see changes'; statusEl.style.color = '#22c55e'; }
      else { statusEl.textContent = d.error || 'Error'; statusEl.style.color = '#ef4444'; }
    })
    .catch(function() { statusEl.textContent = 'Network error'; statusEl.style.color = '#ef4444'; });
}
</script>


<script nonce="<%= nonce %>">
document.addEventListener('DOMContentLoaded', function() {
  var primaryName = <%- JSON.stringify(group.name) %>;
  var aliases = <%- JSON.stringify((group.aliases || []).slice(0, 2)) %>;
  var terms = [primaryName].concat(aliases).filter(Boolean);
  fetchYaraForEntity(terms, {
    sectionId: 'yara-section',
    wrapId: 'yara-results-wrap',
    badgeId: 'yara-count-badge',
    viewAllId: 'yara-view-all',
    primaryName: primaryName
  });
});
</script>

<%- include('partials/footer') %>
