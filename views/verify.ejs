<%- include('partials/head', { pageTitle: 'Verify Email' }) %>

<div class="page-header">
  <h1>Verify Your Email</h1>
  <p>Confirm your email address to activate your alerts.</p>
</div>

<p class="text-muted" style="margin-bottom:1.5rem">
  Click the button below to verify your email and start receiving threat intelligence alerts.
</p>

<form action="/alerts/verify" method="POST">
  <input type="hidden" name="verify_token" value="<%= verifyToken %>">
  <button type="submit" class="btn btn-accent">Verify Email</button>
</form>

<%- include('partials/footer') %>
