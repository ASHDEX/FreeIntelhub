      <div class="footer-brand-row">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" class="footer-brand-icon"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        <span class="footer-brand-name">FreeIntelHub</span>
        <span class="footer-brand-sep">·</span>
        <span class="footer-brand-sub">Open-source CTI platform</span>
      </div>
      <p class="footer-legal">All articles belong to their respective owners. FreeIntelHub aggregates publicly available RSS feeds for informational purposes only. <a href="mailto:contact@dailydoesofcybersecuritynews.com">DMCA</a></p>
    </footer>

  </div><!-- /.app-body -->
</div><!-- /.app-shell -->

<button id="back-to-top" class="back-to-top" aria-label="Back to top" hidden>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M18 15l-6-6-6 6"/></svg>
</button>

<script nonce="<%= typeof nonce !== 'undefined' ? nonce : '' %>">
(function(){
  // Sidebar collapse toggle
  var sb = document.getElementById('sidebar');
  var ab = document.getElementById('app-body');
  var colBtn = document.getElementById('sb-collapse-btn');
  var mobileBtn = document.getElementById('sb-mobile-btn');

  var collapsed = localStorage.getItem('sb-collapsed') === '1';
  if (collapsed && sb) { sb.classList.add('sb-collapsed'); }

  if (colBtn && sb) {
    if (collapsed) colBtn.setAttribute('aria-expanded', 'false');
    colBtn.addEventListener('click', function() {
      collapsed = !collapsed;
      sb.classList.toggle('sb-collapsed', collapsed);
      colBtn.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
      colBtn.setAttribute('aria-label', collapsed ? 'Expand sidebar' : 'Collapse sidebar');
      localStorage.setItem('sb-collapsed', collapsed ? '1' : '0');
    });
  }

  // Mobile sidebar toggle
  if (mobileBtn && sb) {
    mobileBtn.addEventListener('click', function() {
      sb.classList.toggle('sb-mobile-open');
    });
    document.addEventListener('click', function(e) {
      if (!sb.contains(e.target) && !mobileBtn.contains(e.target)) {
        sb.classList.remove('sb-mobile-open');
      }
    });
  }
})();
</script>

</body>
</html>
