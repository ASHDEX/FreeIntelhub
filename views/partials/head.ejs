<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle + ' — ' : '' %>FreeIntelHub</title>
  <meta name="description" content="<%= typeof pageDescription !== 'undefined' ? pageDescription : 'FreeIntelHub — Open-source cybersecurity threat intelligence aggregator. Real-time news, CVEs, MITRE ATT&CK mapping, IOC extraction from 30+ sources.' %>">
  <meta property="og:title" content="<%= typeof pageTitle !== 'undefined' ? pageTitle + ' — ' : '' %>FreeIntelHub">
  <meta property="og:description" content="<%= typeof pageDescription !== 'undefined' ? pageDescription : 'Open-source cybersecurity threat intelligence aggregator with real-time news, CVEs, and IOC extraction.' %>">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="FreeIntelHub">
  <meta name="twitter:card" content="summary">
  <meta name="robots" content="index, follow">
  <link rel="alternate" type="application/rss+xml" title="FreeIntelHub RSS Feed" href="/feed/all.xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="stylesheet" href="/style.css">
  <script src="/app.js" defer></script>
</head>
<body>
<a href="#main-content" class="skip-link">Skip to main content</a>
<!-- Aurora background orbs -->
<div class="aurora-orb aurora-orb-1" aria-hidden="true"></div>
<div class="aurora-orb aurora-orb-2" aria-hidden="true"></div>
<div class="aurora-orb aurora-orb-3" aria-hidden="true"></div>
<div class="app-shell">

  <!-- ═══ SIDEBAR ═══ -->
  <aside class="sidebar" id="sidebar">

    <!-- Brand -->
    <div class="sb-header">
      <a href="/" class="sb-brand">
        <div class="sb-brand-icon">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M2.5 13c0-2 1.5-3.5 3.5-3.5h3c.5-3 1.5-6.5 2-6.5s1.5 3.5 2 6.5l4.5 1.5 3-2.5-1.5 4 1.5 3.5-3-1.5c-2 2-5.5 3.5-9 3.5l-2.5 1.5-1-2c-1.5-.5-2.5-1.5-2.5-3z"/></svg>
        </div>
        <div class="sb-brand-text">
          <span class="sb-brand-name">FreeIntelHub</span>
          <span class="sb-brand-sub">TI Platform</span>
        </div>
      </a>
    </div>

    <!-- Navigation -->
    <nav class="sb-nav">

      <div class="sb-group">
        <span class="sb-group-label">Overview</span>
        <a href="/dashboard" class="sb-item<%= currentPath === '/dashboard' ? ' sb-active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
          <span>Dashboard</span>
        </a>
        <a href="/feed" class="sb-item<%= currentPath === '/feed' ? ' sb-active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/></svg>
          <span>Threat Feed</span>
        </a>
        <a href="/trending" class="sb-item<%= currentPath === '/trending' ? ' sb-active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
          <span>Trending</span>
        </a>
      </div>

      <div class="sb-group">
        <span class="sb-group-label">Investigation</span>
        <a href="/lookup" class="sb-item<%= currentPath === '/lookup' ? ' sb-active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
          <span>IOC Search</span>
        </a>
        <a href="/iocs" class="sb-item<%= currentPath === '/iocs' ? ' sb-active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/></svg>
          <span>Intel Items</span>
        </a>
        <a href="/cases" class="sb-item<%= currentPath === '/cases' || currentPath.startsWith('/cases/') ? ' sb-active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
          <span>Cases</span>
        </a>
        <a href="/mitre" class="sb-item<%= currentPath === '/mitre' ? ' sb-active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="3 11 22 2 13 21 11 13 3 11"/></svg>
          <span>ATT&amp;CK Map</span>
        </a>
        <a href="/yara-rules" class="sb-item<%= currentPath === '/yara-rules' ? ' sb-active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
          <span>Detection Rules</span>
        </a>
        <a href="/pastes" class="sb-item<%= currentPath === '/pastes' ? ' sb-active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
          <span>Paste Monitor</span>
        </a>
      </div>

      <div class="sb-group">
        <span class="sb-group-label">Analytics</span>
        <a href="/heatmap" class="sb-item<%= currentPath === '/heatmap' ? ' sb-active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M3 15h18M9 3v18M15 3v18"/></svg>
          <span>Threat Heatmap</span>
        </a>
        <a href="/geomap" class="sb-item<%= currentPath === '/geomap' ? ' sb-active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
          <span>Geo View</span>
        </a>
        <a href="/vulnerability" class="sb-item<%= currentPath === '/vulnerability' ? ' sb-active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          <span>CVE Lookup</span>
        </a>
        <a href="/cve-priority" class="sb-item<%= currentPath === '/cve-priority' ? ' sb-active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          <span>CVE Priority</span>
        </a>
      </div>

      <div class="sb-group">
        <span class="sb-group-label">Actors</span>
        <a href="/threat-groups" class="sb-item<%= currentPath === '/threat-groups' || currentPath.startsWith('/threat-group/') ? ' sb-active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          <span>Threat Groups</span>
        </a>
        <a href="/software" class="sb-item<%= currentPath === '/software' || currentPath.startsWith('/software/') ? ' sb-active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
          <span>Software</span>
        </a>
        <a href="/campaigns" class="sb-item<%= currentPath === '/campaigns' || currentPath.startsWith('/campaign/') ? ' sb-active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
          <span>Campaigns</span>
        </a>
      </div>

      <div class="sb-group">
        <span class="sb-group-label">Explore</span>
        <a href="/sources" class="sb-item<%= currentPath === '/sources' || currentPath.startsWith('/source/') ? ' sb-active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/></svg>
          <span>Sources</span>
        </a>
        <a href="/vendors" class="sb-item<%= currentPath === '/vendors' || currentPath.startsWith('/vendor/') ? ' sb-active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/></svg>
          <span>Vendors</span>
        </a>
        <a href="/categories" class="sb-item<%= currentPath === '/categories' || currentPath.startsWith('/category/') ? ' sb-active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
          <span>Categories</span>
        </a>
        <a href="/sectors" class="sb-item<%= currentPath === '/sectors' || currentPath.startsWith('/sector/') ? ' sb-active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="6" height="4"/><rect x="2" y="10" width="6" height="11"/><rect x="9" y="7" width="6" height="14"/><rect x="16" y="3" width="6" height="18"/></svg>
          <span>Sectors</span>
        </a>
        <a href="/watchlist" class="sb-item<%= currentPath === '/watchlist' ? ' sb-active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
          <span>Watchlist</span>
        </a>
      </div>

      <div class="sb-group">
        <span class="sb-group-label">System</span>
        <a href="/alerts" class="sb-item<%= currentPath === '/alerts' ? ' sb-active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
          <span>Alerts</span>
        </a>
        <a href="/bookmarks" class="sb-item<%= currentPath === '/bookmarks' ? ' sb-active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
          <span>Bookmarks</span>
        </a>
        <a href="/ssl-blacklist" class="sb-item<%= currentPath === '/ssl-blacklist' ? ' sb-active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          <span>SSL Blacklist</span>
        </a>
        <a href="/feed/all.xml" class="sb-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/></svg>
          <span>RSS Feed</span>
        </a>
      </div>

    </nav>

    <!-- Collapse button at bottom -->
    <div class="sb-footer-area">
      <button class="sb-collapse-btn" id="sb-collapse-btn" aria-label="Collapse sidebar" aria-expanded="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 18-6-6 6-6"/><path d="M20 6v12"/></svg>
        <span>Collapse</span>
      </button>
    </div>

  </aside>

  <!-- ═══ APP BODY ═══ -->
  <div class="app-body" id="app-body">

    <!-- Topbar -->
    <header class="topbar">
      <button class="sb-mobile-btn" id="sb-mobile-btn" aria-label="Toggle sidebar">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:18px;height:18px"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>

      <div class="topbar-search-wrap">
        <form action="/search" method="GET" class="topbar-search" autocomplete="off">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
          <input type="text" id="topbar-search-input" name="q" placeholder="Search threats, actors, CVEs..." aria-label="Search threats, actors, CVEs" value="<%= typeof query !== 'undefined' ? query : '' %>" autocomplete="off">
          <kbd class="topbar-kbd">/</kbd>
        </form>
        <div class="topbar-suggestions" id="topbar-suggestions"></div>
      </div>

      <div class="topbar-right">
        <div class="topbar-live">
          <span class="live-dot"></span>
          Live
        </div>
        <button class="theme-toggle" id="theme-toggle" aria-label="Toggle theme" aria-pressed="false">
          <svg class="theme-icon-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
          <svg class="theme-icon-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        </button>
        <a href="/alerts" class="topbar-icon-btn" title="Alerts">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:16px;height:16px"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
        </a>
        <a href="/search" class="topbar-user-chip">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          <span>Guest</span>
        </a>
      </div>
    </header>

    <main class="main-content" id="main-content">
