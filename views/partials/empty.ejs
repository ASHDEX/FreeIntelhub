<div class="empty-state">
  <svg class="empty-state-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
    <% if (typeof icon !== 'undefined' && icon === 'search') { %>
      <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
    <% } else if (typeof icon !== 'undefined' && icon === 'folder') { %>
      <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
    <% } else if (typeof icon !== 'undefined' && icon === 'bookmark') { %>
      <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>
    <% } else if (typeof icon !== 'undefined' && icon === 'bell') { %>
      <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/>
    <% } else { %>
      <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
    <% } %>
  </svg>
  <p class="empty-state-title"><%= typeof title !== 'undefined' ? title : 'Nothing here yet' %></p>
  <% if (typeof subtitle !== 'undefined' && subtitle) { %>
    <p class="empty-state-sub"><%= subtitle %></p>
  <% } %>
  <% if (typeof ctaHref !== 'undefined' && ctaHref) { %>
    <a href="<%= ctaHref %>" class="btn btn-primary" style="margin-top:1rem"><%= typeof ctaLabel !== 'undefined' ? ctaLabel : 'Get Started' %></a>
  <% } %>
</div>
