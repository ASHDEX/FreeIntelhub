<%- include('partials/head', { pageTitle: sw.name }) %>

<%
  const swTypeLabel = {
    ransomware:'Ransomware', stealer:'Stealer/Infostealer', loader:'Loader/Dropper',
    rat:'RAT', backdoor:'Backdoor', c2:'C2 Framework', trojan:'Trojan',
    wiper:'Wiper', rootkit:'Rootkit', spyware:'Spyware', keylogger:'Keylogger',
    botnet:'Botnet', unknown:'Other/Unknown'
  };
  const swTypeColor = {
    ransomware:'badge-red', stealer:'badge-orange', loader:'badge-yellow',
    rat:'badge-blue', backdoor:'badge-purple', c2:'badge-red',
    trojan:'badge-orange', wiper:'badge-red', rootkit:'badge-purple',
    spyware:'badge-blue', keylogger:'badge-blue', botnet:'badge-orange', unknown:'badge-gray'
  };
%>

<nav class="breadcrumb" aria-label="Breadcrumb">
  <a href="/" class="breadcrumb-item">Home</a>
  <span class="breadcrumb-sep" aria-hidden="true">›</span>
  <a href="/software" class="breadcrumb-item">Software &amp; Malware</a>
  <span class="breadcrumb-sep" aria-hidden="true">›</span>
  <span class="breadcrumb-item breadcrumb-current" aria-current="page"><%= sw.name %></span>
</nav>

<div class="page-header">
  <div class="entity-header">
    <div class="entity-header-title">
      <h1><%= sw.name %></h1>
      <div class="entity-badges">
        <span class="badge <%= swTypeColor[sw.type] || 'badge-gray' %>"><%= swTypeLabel[sw.type] || sw.type %></span>
        <% if (sw.is_auto_detected) { %><span class="badge badge-gray">auto-detected</span><% } %>
      </div>
    </div>
    <% if (sw.description) { %>
      <p class="entity-description"><%= sw.description %></p>
    <% } %>
    <% if (sw.aliases && sw.aliases.length > 0) { %>
      <p class="entity-aliases"><strong>Also known as:</strong> <%= sw.aliases.join(', ') %></p>
    <% } %>
    <% if (sw.malpedia_slug) { %>
      <p class="entity-aliases" style="margin-top:.4rem;display:flex;align-items:center;gap:.5rem;flex-wrap:wrap;">
        <a href="https://malpedia.caad.fkie.fraunhofer.de/details/<%= encodeURIComponent(sw.malpedia_slug) %>" target="_blank" rel="noopener noreferrer" class="badge" style="background:rgba(99,102,241,.15);color:#818cf8;border:1px solid rgba(99,102,241,.3);text-decoration:none;font-size:.72rem;">Malpedia ↗</a>
        <% try { var _refs = JSON.parse(sw.malpedia_refs || '[]'); if (_refs.length) { %><span class="badge" style="font-size:.7rem;color:var(--text-muted);border:1px solid var(--border)"><%= _refs.length %> research refs</span><% } } catch(_e){} %>
      </p>
    <% } %>
  </div>
</div>

<!-- AI Intelligence Brief -->
<section class="activity-section">
  <h2 style="display:flex;align-items:center;gap:.5rem">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="15" height="15" style="color:var(--accent)"><path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2z"/><path d="M12 8v4l3 3"/></svg>
    AI Intelligence Brief
    <span class="hidden" id="ai-brief-badge" style="font-size:.65rem;font-weight:600;padding:.1rem .4rem;border-radius:4px;background:var(--bg-elevated);color:var(--text-muted);border:1px solid var(--border)">cached</span>
  </h2>
  <div id="ai-brief-card" class="ai-brief-card">
    <div class="ai-brief-prompt"><button class="ai-brief-gen-btn" id="ai-brief-btn"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14" style="flex-shrink:0"><path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2z"/><path d="M12 8v4l3 3"/></svg> Additional Insights</button></div>
  </div>
</section>

<!-- Related YARA Rules -->
<section class="activity-section" id="yara-section">
  <h2 class="section-h2-flex">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="15" height="15" style="color:#22c55e"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
    Related YARA Rules
    <span id="yara-count-badge" class="yara-count-badge" hidden></span>
    <a id="yara-view-all" href="/yara-rules" class="yara-view-all-link" hidden>View all on YARA Rules page →</a>
  </h2>
  <div id="yara-results-wrap"></div>
</section>

<!-- 90-Day Activity Chart -->
<section class="activity-section">
  <h2>90-Day Activity</h2>
  <div class="chart-container chart-container-sm">
    <canvas id="activity-chart"></canvas>
  </div>
</section>

<!-- Articles -->
<section>
  <div class="entity-articles-header">
    <h2>
      <%= showAll ? 'All Articles' : 'Last 90 Days' %>
      <span class="entity-count">(<%= total %>)</span>
    </h2>
    <div class="entity-toggle">
      <% if (showAll) { %>
        <a href="<%= baseUrl %>" class="btn btn-sm">Last 90 Days</a>
        <span class="btn btn-sm btn-accent">All Time</span>
      <% } else { %>
        <span class="btn btn-sm btn-accent">Last 90 Days</span>
        <a href="<%= baseUrl %>?all=1" class="btn btn-sm">All Time</a>
      <% } %>
    </div>
  </div>

  <% if (articles.length === 0) { %>
    <p class="empty">No articles found for this period.</p>
  <% } else { %>
    <%- include('partials/articleList', { articles }) %>
    <%- include('partials/pagination', { page, pages, baseUrl: showAll ? baseUrl + '?all=1' : baseUrl }) %>
  <% } %>
</section>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js"></script>
<script nonce="<%= nonce %>">
(function() {
  var aiBriefBtn = document.getElementById('ai-brief-btn');
  if (aiBriefBtn) aiBriefBtn.addEventListener('click', function() { fetchAiBrief('software', <%= sw.id %>); });
})();
</script>

<script nonce="<%= nonce %>">
(function() {
  var days   = <%- JSON.stringify(dailyCounts.map(d => d.day.slice(5))) %>;
  var counts = <%- JSON.stringify(dailyCounts.map(d => d.count)) %>;
  var ctx = document.getElementById('activity-chart').getContext('2d');
  new Chart(ctx, {
    type: 'bar',
    data: {
      labels: days,
      datasets: [{
        label: 'Articles',
        data: counts,
        backgroundColor: 'rgba(251,146,60,0.6)',
        borderColor: '#fb923c',
        borderWidth: 1,
        borderRadius: 2,
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: { legend: { display: false } },
      scales: {
        x: { ticks: { maxTicksLimit: 10, color: '#94a3b8' }, grid: { color: 'rgba(148,163,184,0.1)' } },
        y: { beginAtZero: true, ticks: { color: '#94a3b8', stepSize: 1 }, grid: { color: 'rgba(148,163,184,0.1)' } }
      }
    }
  });
})();
</script>


<script nonce="<%= nonce %>">
document.addEventListener('DOMContentLoaded', function() {
  var primaryName = <%- JSON.stringify(sw.name) %>;
  var aliases = <%- JSON.stringify((sw.aliases || []).slice(0, 2)) %>;
  var terms = [primaryName].concat(aliases).filter(Boolean);
  fetchYaraForEntity(terms, {
    sectionId: 'yara-section',
    wrapId: 'yara-results-wrap',
    badgeId: 'yara-count-badge',
    viewAllId: 'yara-view-all',
    primaryName: primaryName
  });
});
</script>

<%- include('partials/footer') %>
