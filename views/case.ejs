<%- include('partials/head', { pageTitle: pageTitle }) %>

<%
  var statusColors = { open: '#3b82f6', 'in-progress': '#eab308', closed: '#64748b', 'false-positive': '#ef4444' };
  var sevColors = { critical: '#ef4444', high: '#f97316', medium: '#eab308', low: '#22c55e' };
%>

<!-- Case header -->
<div style="background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:1.25rem 1.5rem;margin-bottom:1.25rem">
  <div style="display:flex;align-items:flex-start;gap:1rem;flex-wrap:wrap">
    <div style="width:6px;border-radius:3px;background:<%= sevColors[case.severity] || '#64748b' %>;align-self:stretch;flex-shrink:0"></div>
    <div style="flex:1;min-width:0">
      <div style="display:flex;align-items:center;gap:.75rem;margin-bottom:.5rem;flex-wrap:wrap">
        <span class="badge-status badge-status-<%= case.status.replace(' ','-') %>"><%= case.status %></span>
        <span class="badge-case-severity badge-case-severity-<%= case.severity %>"><%= case.severity %></span>
        <span style="color:var(--text-muted);font-size:.78rem">Case #<%= case.id %></span>
        <span style="color:var(--text-muted);font-size:.78rem">&middot; <%= articles.length %> article<%= articles.length !== 1 ? 's' : '' %></span>
        <span style="color:var(--text-muted);font-size:.78rem">&middot; Opened <%= new Date(case.created_at).toLocaleDateString('en-US',{year:'numeric',month:'short',day:'numeric'}) %></span>
      </div>
      <h1 style="margin:0 0 .4rem;font-size:1.2rem"><%= case.title %></h1>
      <% if (case.description) { %>
        <p style="margin:0;color:var(--text-muted);font-size:.875rem"><%= case.description %></p>
      <% } %>
    </div>
    <!-- Status change form -->
    <form method="POST" action="/cases/<%= case.id %>/status" style="display:flex;gap:.4rem;align-items:center;flex-shrink:0">
      <select name="status" style="background:var(--bg-elevated);border:1px solid var(--border);color:var(--text);border-radius:6px;padding:.35rem .6rem;font-size:.8rem">
        <% ['open','in-progress','closed','false-positive'].forEach(function(s) { %>
          <option value="<%= s %>" <%= case.status === s ? 'selected' : '' %>><%= s %></option>
        <% }); %>
      </select>
      <button type="submit" class="btn btn-sm btn-primary">Update</button>
    </form>
  </div>
</div>

<!-- Two-column layout: articles + notes -->
<div style="display:grid;grid-template-columns:1fr 380px;gap:1.25rem;align-items:start">

  <!-- Articles panel -->
  <div>
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:.75rem">
      <h2 style="margin:0;font-size:.95rem;font-weight:600">Linked Articles</h2>
      <span style="color:var(--text-muted);font-size:.8rem"><%= articles.length %> total</span>
    </div>
    <% if (articles.length === 0) { %>
      <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:2rem;text-align:center;color:var(--text-muted)">
        <p style="margin:0">No articles linked yet. Use the "Case" button on any article to add it here.</p>
      </div>
    <% } else { %>
      <div style="display:grid;gap:.6rem">
        <% articles.forEach(function(a) { %>
          <div class="case-article-item">
            <div style="flex:1;min-width:0">
              <div style="display:flex;align-items:center;gap:.5rem;margin-bottom:.25rem;flex-wrap:wrap">
                <span class="badge badge-source" style="font-size:.7rem"><%= a.source %></span>
                <% if (a.category) { %><span class="badge badge-category" style="font-size:.7rem"><%= a.category %></span><% } %>
                <span style="color:var(--text-muted);font-size:.72rem;margin-left:auto">Added <%= new Date(a.added_at).toLocaleDateString('en-US',{month:'short',day:'numeric'}) %></span>
              </div>
              <a href="<%= safeHref(a.link) %>" target="_blank" rel="noopener noreferrer" style="font-size:.88rem;font-weight:500;color:var(--text);text-decoration:none;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden">
                <%= a.title %>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:11px;height:11px;display:inline;margin-left:3px;opacity:.5"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
              </a>
            </div>
            <button class="remove-case-article" data-case="<%= case.id %>" data-article="<%= a.id %>" title="Remove from case" style="background:none;border:none;color:var(--text-muted);cursor:pointer;padding:.25rem;flex-shrink:0">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>

  <!-- Notes panel -->
  <div>
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:.75rem">
      <h2 style="margin:0;font-size:.95rem;font-weight:600">Analyst Notes</h2>
      <span style="color:var(--text-muted);font-size:.8rem"><%= notes.length %> note<%= notes.length !== 1 ? 's' : '' %></span>
    </div>

    <!-- Note timeline -->
    <div style="display:grid;gap:.5rem;margin-bottom:1rem">
      <% notes.forEach(function(n) { %>
        <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:.75rem 1rem">
          <div style="display:flex;align-items:center;gap:.5rem;margin-bottom:.35rem">
            <div style="width:24px;height:24px;border-radius:50%;background:var(--accent-soft);display:flex;align-items:center;justify-content:center;font-size:.7rem;font-weight:600;color:var(--accent)">
              <%= n.author ? n.author[0].toUpperCase() : 'A' %>
            </div>
            <span style="font-size:.8rem;font-weight:500"><%= n.author || 'analyst' %></span>
            <span style="color:var(--text-muted);font-size:.72rem;margin-left:auto">
              <%= new Date(n.created_at).toLocaleDateString('en-US',{month:'short',day:'numeric',hour:'2-digit',minute:'2-digit'}) %>
            </span>
          </div>
          <p style="margin:0;font-size:.83rem;white-space:pre-wrap"><%= n.note %></p>
        </div>
      <% }); %>
      <% if (notes.length === 0) { %>
        <p style="color:var(--text-muted);font-size:.83rem;text-align:center;padding:.5rem">No notes yet.</p>
      <% } %>
    </div>

    <!-- Add note form -->
    <form method="POST" action="/cases/<%= case.id %>/notes" style="background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:.75rem 1rem;display:grid;gap:.5rem">
      <input type="text" name="author" placeholder="Your name (optional)" style="background:var(--bg-elevated);border:1px solid var(--border);color:var(--text);border-radius:6px;padding:.4rem .6rem;font-size:.8rem">
      <textarea name="note" rows="3" placeholder="Add analyst note..." required style="background:var(--bg-elevated);border:1px solid var(--border);color:var(--text);border-radius:6px;padding:.4rem .6rem;font-size:.8rem;resize:vertical"></textarea>
      <button type="submit" class="btn btn-primary btn-sm">Add Note</button>
    </form>

    <!-- Danger zone -->
    <div style="margin-top:1.5rem;padding-top:1rem;border-top:1px solid var(--border)">
      <button class="btn btn-sm" style="color:#ef4444;border-color:rgba(239,68,68,.3);background:rgba(239,68,68,.06)" onclick="deleteCase(<%= case.id %>)">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:13px;height:13px"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6M14 11v6"/></svg>
        Delete Case
      </button>
    </div>
  </div>

</div>

<script nonce="<%= typeof nonce !== 'undefined' ? nonce : '' %>">
document.querySelectorAll('.remove-case-article').forEach(function(btn) {
  btn.addEventListener('click', async function() {
    const caseId = this.dataset.case;
    const articleId = this.dataset.article;
    if (!confirm('Remove this article from the case?')) return;
    const r = await fetch('/api/cases/' + caseId + '/articles/' + articleId, { method: 'DELETE' });
    if (r.ok) this.closest('.case-article-item').remove();
  });
});

async function deleteCase(id) {
  if (!confirm('Permanently delete this case? Articles will not be deleted.')) return;
  const r = await fetch('/api/cases/' + id, { method: 'DELETE' });
  if (r.ok) window.location.href = '/cases';
}
</script>

<%- include('partials/footer') %>
