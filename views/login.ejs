<%- include('partials/head', { pageTitle: 'Login' }) %>

<div class="login-page">
  <div class="login-wrap">
    <div class="login-brand">
      <a href="/" class="logo login-logo">Free<span>Intel</span>Hub</a>
      <h2 class="login-title">Sign in</h2>
      <p class="login-subtitle">Access analyst features and admin panel</p>
    </div>

    <div class="dash-widget">
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="login-error" role="alert"><%= error %></div>
      <% } %>

      <form method="POST" action="/login" class="login-form">
        <input type="hidden" name="next" value="<%= typeof next !== 'undefined' ? next : '/dashboard' %>">
        <div class="login-field">
          <label for="login-username" class="login-label">Username</label>
          <input type="text" id="login-username" name="username" required autocomplete="username" class="login-input">
        </div>
        <div class="login-field">
          <label for="login-password" class="login-label">Password</label>
          <input type="password" id="login-password" name="password" required autocomplete="current-password" class="login-input">
        </div>
        <button type="submit" class="btn btn-primary login-btn">Sign In</button>
      </form>
    </div>

    <p class="login-footer-note">
      User accounts are managed by your administrator. <a href="/admin" class="login-footer-link">Admin panel</a>
    </p>
  </div>
</div>

<%- include('partials/footer') %>
