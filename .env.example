PORT=3000

# Network binding — defaults to 127.0.0.1 (loopback only).
# Set to 0.0.0.0 only if you need to bind all interfaces (e.g., inside Docker).
BIND_HOST=127.0.0.1

# Reverse proxy — set to 1 when behind nginx/Cloudflare for correct IP rate limiting
# TRUST_PROXY=1

# HTTPS enforcement — set to true in production behind a TLS-terminating reverse proxy
# FORCE_HTTPS=true

# SQLite database path — defaults to db/freeintelhub.sqlite inside the app directory.
# In production, store outside the web root: e.g., /var/data/freeintelhub/db.sqlite
# DB_PATH=/var/data/freeintelhub/db.sqlite

# Webhook URL encryption key — 64 hex characters (32 bytes, AES-256-GCM).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Leave empty to disable encryption (not recommended in production).
# WEBHOOK_ENCRYPTION_KEY=

# SMTP — required for email verification, alerts, and newsletter
# Leave empty to auto-verify subscribers and disable email sending
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_password
FROM_EMAIL=alerts@freeintelhub.com

# Public base URL for email links
BASE_URL=http://localhost:3000

# Article retention (days) — how long articles are kept before auto-purge (default: 365)
ARTICLE_RETENTION_DAYS=365

# Newsletter cron schedule (default: 7:00 AM UTC daily)
NEWSLETTER_CRON=0 7 * * *

# AbuseIPDB API key — enables abuse confidence scoring on the IP & Domain Lookup (/iprep) page.
# Free tier: https://www.abuseipdb.com/register  (1,000 checks/day)
# Leave empty to disable AbuseIPDB lookups (other data sources still work without it).
ABUSEIPDB_KEY=

# Claude API Configuration
# Get your API key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Default model for testing (recommended for cost savings)
# Note: claude-haiku-4-5 is the latest Haiku model as of October 2025
CLAUDE_MODEL=claude-haiku-4-5

# Optional: Test mode settings
TEST_MODE=true
MAX_TOKENS=10

# Optional: Verbose output for debugging
DEBUG=false
