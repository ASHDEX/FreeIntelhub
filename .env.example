PORT=3000

# Network binding — defaults to 127.0.0.1 (loopback only).
# Set to 0.0.0.0 only if you need to bind all interfaces (e.g., inside Docker).
BIND_HOST=127.0.0.1

# Reverse proxy — set to 1 when behind nginx/Cloudflare for correct IP rate limiting
# TRUST_PROXY=1

# HTTPS enforcement — set to true in production behind a TLS-terminating reverse proxy
# FORCE_HTTPS=true

# SQLite database path — defaults to db/freeintelhub.sqlite inside the app directory.
# In production, store outside the web root: e.g., /var/data/freeintelhub/db.sqlite
# DB_PATH=/var/data/freeintelhub/db.sqlite

# Webhook URL encryption key — 64 hex characters (32 bytes, AES-256-GCM).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Leave empty to disable encryption (not recommended in production).
# WEBHOOK_ENCRYPTION_KEY=

# SMTP — required for email verification, alerts, and newsletter
# Leave empty to auto-verify subscribers and disable email sending
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_password
FROM_EMAIL=alerts@freeintelhub.com

# Public base URL for email links
BASE_URL=http://localhost:3000

# Article retention (days) — how long articles are kept before auto-purge (default: 365)
ARTICLE_RETENTION_DAYS=365

# RSS fetch concurrency — caps simultaneous feed requests during scheduled ingestion.
# Lower this on small hosts; raise carefully if feeds are slow and the host has headroom.
RSS_FETCH_CONCURRENCY=8

# Newsletter cron schedule (default: 7:00 AM UTC daily)
NEWSLETTER_CRON=0 7 * * *

# AbuseIPDB API key — enables IP reputation scoring on the IOC Lookup (/lookup) page.
# Free tier: https://www.abuseipdb.com/register  (1,000 checks/day)
# Leave empty to disable AbuseIPDB lookups (other data sources still work without it).
ABUSEIPDB_KEY=

# CheckPhish API key — enables phishing URL analysis on the Phishing Lookup page.
# Free tier: https://checkphish.ai  (register for an API key)
# Leave empty to skip CheckPhish lookups.
CHECKPHISH_API_KEY=

# PhishingInitiative API key — enables phishing URL verdicts on the Phishing Lookup page.
# Register at https://phishing-initiative.fr to get a free API key.
PHISHING_INITIATIVE_KEY=

# VirusTotal API key — enables file hash scanning on the IOC Lookup (/lookup) page.
# Free tier: https://www.virustotal.com/gui/join-us  (4 lookups/min, 500/day)
# Leave empty to disable hash lookups.
VIRUSTOTAL_API_KEY=

# MalShare API key — enables hash lookup enrichment and dashboard recent malware feed.
# Free tier: https://malshare.com/register.php  (2,000 req/day)
# Leave empty to disable MalShare enrichment.
MALSHARE_API_KEY=

# abuse.ch API key — powers MalwareBazaar hash lookup, ThreatFox IOC search,
# URLhaus host lookups, YARA rule search, and SSL Blacklist sync.
# Register at https://abuse.ch to get a free API key.
ABUSECH_API_KEY=

# Session secret for user authentication — generate a strong random string.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SESSION_SECRET=

# AI Intelligence Briefs — powered by local analysis (no API key required).
# Briefs are generated automatically from article titles and entity metadata.
#
# Optional upgrade 1: Groq (free cloud LLM — fast, high quality)
# Get a free API key at https://console.groq.com
# GROQ_API_KEY=
# GROQ_MODEL=llama3-8b-8192
#
# Optional upgrade 2: Ollama (local LLM, fully offline, no API key)
# Install from https://ollama.com, then: ollama pull llama3.2
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2

# Dark Web Monitoring
# Start Tor daemon first: brew services start tor  (macOS) or systemctl start tor  (Ubuntu)
# The app connects through Tor automatically via SOCKS5 — no torsocks wrapper needed.
# Override Tor proxy (default: socks5h://127.0.0.1:9050)
# TOR_SOCKS_PROXY=socks5h://127.0.0.1:9050
# Optional extra targets beyond the deepdarkCTI gang list
# Format: Name|http://xxx.onion|category  (comma-separated, categories: paste|forum|custom)
DW_MONITORED_SITES=
